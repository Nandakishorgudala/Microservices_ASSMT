## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Vv][Ss][Pp][Ss][Cc][Cc]

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# Build tool reports, caches and settings
*.TrendData
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio profiling results
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Code project settings
.vscode/

# JSON settings for Visual Studio
launch.json

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# MongoDB logs/data if local
*.log
# storage/

# SQL Server files
App_Data/*.mdf
App_Data/*.ldf
*.mdf
*.ldf

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
bin/
obj/
out/

# Environments
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.sample

# IDE - JetBrains
.idea/
*.iws
*.iml
*.ipr

# User-specific tools
.gemini/
.antigravity/
.antigravityignore
